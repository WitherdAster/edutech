# Database
DATABASE_URL=mysql+pymysql://root:@localhost/edutech

# JWT
JWT_SECRET=edutech-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload directories (default: system temp dir /tmp)
# Hanya set jika ingin custom path
# ATTENDANCE_UPLOAD_DIR=/tmp
# REGISTER_UPLOAD_DIR=/tmp

# API Key for Android device (kosongkan untuk bypass di local dev)
API_KEY= 
